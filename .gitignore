# Proteus generated files
# =========================

*.workspace
*.log
*.backup
*.bak

# Keep actual Proteus project files
!*.pdsprj
!*.dsn

# =========================
# Operating system files
# =========================

.DS_Store
Thumbs.db
desktop.ini

# =========================
# Temporary files
# =========================

*.swp
*.temp
*~
