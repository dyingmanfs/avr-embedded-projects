                                 ; 250ms delay using Timer1 CTC Mode
                                 DELAY_250ms:
000221 e040                          LDI R20, HIGH(244)
000222 bd4b                          OUT OCR1AH, R20
000223 ef44                          LDI R20, LOW(244)
000224 bd4a                          OUT OCR1AL, R20
                                 
000225 e040                          LDI R20, 0x00             ; Reset Timer1 count
000226 bd4d                          OUT TCNT1H, R20
000227 bd4c                          OUT TCNT1L, R20
                                 
000228 e040                          LDI R20, 0x00
000229 bd4f                          OUT TCCR1A, R20
00022a e04d                          LDI R20, (1<<WGM12)|(1<<CS12)|(1<<CS10) ; CTC Mode, Prescaler 1024
00022b bd4e                          OUT TCCR1B, R20
                                 
                                 WAIT_CTC:
00022c b746                          IN R20, TIFR
00022d ff44                          SBRS R20, OCF1A           ; Wait for compare match
00022e 940c 022c                     JMP WAIT_CTC
                                 
000230 e140                          LDI R20, (1<<OCF1A)       ; Clear compare flag
000231 bf46                          OUT TIFR, R20
                                 
000232 e040                          LDI R20, 0x00             ; Stop Timer1
000233 bd4e                          OUT TCCR1B, R20
000234 bd4f                          OUT TCCR1A, R20
000235 9508                          RET
