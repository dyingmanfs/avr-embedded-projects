00001f 9a90                      SBI PORTD, 0                  ; INT0 initially inactive
000020 9a91                      SBI PORTD, 1                  ; INT0 initially inactive
                                 
000021 e040                      LDI R20, 0x00
000022 bf49                      OUT EIMSK, R20                ; Disable INT0 initially
                                 
000023 9478                      SEI                           ; Enable global interrupts
                                 
                                 
                                 
